graph TB
    subgraph Client
        B[Browser]
        M[Mobile Browser]
    end

    subgraph Vercel["Vercel (Frontend)"]
        NX[Next.js App Router<br/>NextAuth v5 + UI Components]
    end

    subgraph Backend["VPS / Self-Hosted (Backend)"]
        FY[Fastify<br/>JWT verify · Zod · Rate limit]
        DT[DB Plugin<br/>withTenant session RLS]
        SV[Services<br/>Business rules · Tier gates]
        RP[Repos<br/>pg-client queries]
    end

    subgraph Database["Self-Hosted Infrastructure"]
        DB[(PostgreSQL 16<br/>Session RLS enabled)]
        FS[Filesystem Storage<br/>UPLOAD_DIR attachments]
    end

    subgraph External["External (planned)"]
        RZ[Razorpay / Stripe]
        RS[Resend / SMTP]
        SN[Sentry]
    end

    B --> NX
    M --> NX
    NX -->|HTTP + JWT Bearer| FY

    FY --> DT
    DT --> SV
    SV --> RP
    RP --> DB
    SV -.->|filesystem I/O| FS

    SV -.->|webhooks| RZ
    SV -.->|email| RS
    FY -.->|errors| SN

    classDef external fill:#FEF3C7,stroke:#92400E,color:#92400E
    classDef infra fill:#DBEAFE,stroke:#1E40AF,color:#1E40AF
    class RZ,RS,SN external
    class DB,FS infra
