# Database (Local / VPS PostgreSQL)
# Runtime — used by the backend. Connects as a restricted, non-owner role
# (glix_app) so Postgres RLS actually applies to it (table owners are exempt
# from their own RLS policies — see db/migrations/020_roles.sql).
DATABASE_URL=postgresql://glix_app:glix_app_dev_password@localhost:5432/glix_dev

# Migrations/seeds only — owns every table, never used by the backend at
# runtime. Read by scripts/migrate.ts and scripts/seed.ts.
DATABASE_URL_MIGRATE=postgresql://glix_user:dev_password@localhost:5432/glix_dev

# JWT & Session Security
JWT_SECRET=generate-a-64-char-random-string-for-local-development-glix
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads

# Networking
PORT=5000
BACKEND_PORT=5000
BACKEND_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:5000
LOG_LEVEL=info

# Auth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=generate-a-64-char-random-string-for-local-development-glix
NEXTAUTH_URL=http://localhost:4000
# NextAuth v5 (Auth.js) reads AUTH_SECRET by default — keep in sync with NEXTAUTH_SECRET above.
AUTH_SECRET=generate-a-64-char-random-string-for-local-development-glix
AUTH_TRUST_HOST=true

# Email (Optional)
RESEND_API_KEY=
